package-as: NearbySpy

# dev/marketing files stay out of the release zip; the runtime set is
# NearbySpy.lua, NearbySpy.toc, NearbySpyIcon.tga, README.md, LICENSE
# Release notes are written by hand in RELEASE_NOTES.md and taken verbatim as
# the GitHub release body. Without this the packager generates one long run-on
# paragraph out of the commit messages.
# ⚠️ The file must contain ONLY the release being tagged: it is copied verbatim,
# so a cumulative file puts the previous release's notes into the new body too
# (happened with 1.5.3, fixed 10.11.2026). Older notes live in the GitHub
# releases themselves and in CHANGELOG-dev.md.
manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown

ignore:
  - CURSEFORGE.md
  - CHANGELOG-dev.md
  - RELEASE_NOTES.md
  - NearbySpy-icon.png
  # "tests" без слэша: шаблон "tests/" packager не матчит, и каталог тестов
  # уезжал в релизный zip (проверено локальной сборкой 05.11.2026).
  - tests

# ship the census snapshot as a second top-level addon folder in the same
# zip (18.10.2026): /nspy server works out of the box — unzip once and both
# addons land in Interface/AddOns. The weekly datapack-latest rolling release
# on GitHub still provides fresh data between addon releases.
move-folders:
  NearbySpy/NearbySpy_Data: NearbySpy_Data
